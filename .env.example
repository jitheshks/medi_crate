# ==========================================
# MediCrate Environment Configuration Template
# ==========================================
# Copy this file to .env and provide your actual environment values.
# NEVER commit the real .env file or production keys to version control.

# MediCrate / Legacy API Configuration
MEDICRATE_API_KEY=your_medicrate_api_key_here
MEDIVAULT_API_KEY=your_legacy_api_key_here

# Supabase Configuration (Phase 3 Preparation)
# Note: In Flutter, ONLY use the public anon key. NEVER use the service-role key!
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key_here

# Google OAuth Web Client ID (Optional for web/backend exchange)
GOOGLE_WEB_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
